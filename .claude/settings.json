{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "powershell",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "dotnet run \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\PreToolUse.cs\"",
                        "timeout": 30
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "dotnet run \"$CLAUDE_PROJECT_DIR/.claude/hooks/PreToolUse.cs\"",
                        "timeout": 30
                    }
                ]
            }
        ]
    },
    "permissions": {
        "defaultMode": "acceptEdits",
        "disableBypassPermissionsMode": "disable",
        "ask": [
            "Bash(git *)",
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git pull *)",
            "Bash(git status *)",
            "Bash(git branch *)",
            "Bash(git checkout *)",
            "Skill(run)",
            "Skill(run:*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./secrets/**)",
            "Bash(rm -rf *)",
            "Bash(git push *)",
            "Bash(git reset *)",
            "Bash(git force-push *)",
            "Bash(git rebase *)",
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)",
            "Read(~/.azure/**)",
            "Read(~/.kube/**)",
            "Read(~/.gnupg/**)",
            "Read(/etc/passwd)",
            "Read(/etc/shadow)",
            "Read(C:\\Users\\*\\AppData\\Local\\Microsoft\\Credentials\\**)",
            "Read(C:\\Users\\*\\AppData\\Roaming\\Microsoft\\Crypto\\**)"
        ],
        "allow": [
            "Bash(dotnet build *)",
            "Bash(dotnet test *)",
            "Bash(npm *)",
            "Bash(npm install *)",
            "Bash(npm run *)",
            "Bash(dotnet nuget *)",
            "Bash(nuget *)",
            "Bash(git clone https://github.com/**)",
            "Bash(git clone git@github.com:*)",
            "Bash(curl https://**)",
            "Bash(wget https://**)",
            "Read(./)",
            "Read(./**)"
        ]
    },
    "sandbox": {
        "enabled": true,
        "credentials": {
            "files": [
                { "path": "~/.ssh/**", "mode": "deny" },
                { "path": "~/.aws/**", "mode": "deny" },
                { "path": "~/.azure/**", "mode": "deny" },
                { "path": "~/.kube/**", "mode": "deny" },
                { "path": "~/.gnupg/**", "mode": "deny" },
                { "path": "/etc/passwd", "mode": "deny" },
                { "path": "/etc/shadow", "mode": "deny" },
                { "path": "C:\\Users\\*\\AppData\\Local\\Microsoft\\Credentials\\**", "mode": "deny" },
                { "path": "C:\\Users\\*\\AppData\\Roaming\\Microsoft\\Crypto\\**", "mode": "deny" }  
            ],
            "envVars": [
                { "name": "GITHUB_TOKEN", "mode": "deny" },
                { "name": "NPM_TOKEN", "mode": "deny" }
            ]
        }
    }
}