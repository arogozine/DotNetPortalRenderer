  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\BuildAssetLoader\BuildAssetLoader.csproj" />
    <ProjectReference Include="..\DoomAssetLoader\DoomAssetLoader.csproj" />
    <ProjectReference Include="..\SoftwareRendererModels\SoftwareRendererModels.csproj" />
  </ItemGroup>

</Project>
